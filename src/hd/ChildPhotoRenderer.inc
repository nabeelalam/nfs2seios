 nfs_cp.nativeFbo=g_framebuffer;nfs_cp.nativeColor=g_framebufferTexture;nfs_cp.nativeDepth=g_framebufferDepth;nfs_cp.nativeHeight=g_framebufferHeight;nfs_cp.x=x;nfs_cp.y=y;nfs_cp.selects=nfs_cp.triangles=0;nfs_cp.selected=100;nfs_cp.active=1;return 1;}
static void nfs_cp_select(unsigned tmu,uint32_t address,uint32_t parity,const GrTexInfo*info,TextureInfo*ti){nfs_cp.bound=0;if(!nfs_cp.active)return;unsigned n=nfs_cp.selects,k=(n%2)*50+n/2;if(n>=100||nfs_cp.triangles!=n*2||!nfs_cp_target()||tmu||parity!=3||!info||info->smallLod!=3||info->largeLod!=3||info->aspectRatio!=3||info->format!=nfs_cp.formats[k]||address!=nfs_cp.addresses[k]||!ti||ti->id!=nfs_cp.native[k]||ti->data!=g_textureMem+address||!nfs_cp_pixels(ti,nfs_cp.words[k],nfs_cp.formats[k])){nfs_cp_cancel();return;}nfs_cp.original=ti->id;nfs_cp.selected=k;++nfs_cp.selects;}
static int nfs_cp_vertex(const GrVertex*v,unsigned cell,unsigned corner){/* Keep slide origins signed after bounding the unsigned cell index. */if(cell>=50||corner>=4)return 0;const int col=(int)(cell/5),row=(int)(cell%5);int right=corner==1||corner==2,bottom=corner>=2;return v&&v->x==(float)(nfs_cp.x+col*32+(right?32:0))+VertexSnap&&v->y==(float)(nfs_cp.y+row*32+(bottom?32:0))+VertexSnap&&v->r==255&&v->g==255&&v->b==255&&v->a==255&&v->oow==1&&v->tmuvtx[0].sow==(right?255:0)&&v->tmuvtx[0].tow==(bottom?255:0);}
static void nfs_cp_triangle(const GrVertex*a,const GrVertex*b,const GrVertex*c){if(!nfs_cp.active)return;unsigned n=nfs_cp.triangles/2,tri=nfs_cp.triangles%2,cell=n/2;if(n>=100||nfs_cp.selects!=n+1||nfs_cp.selected!=(n%2)*50+cell||!nfs_cp_target()||!g_textureEnabled||g_fogEnabled||!nfs_cp_pixels(&g_textures[nfs_cp.addresses[nfs_cp.selected]>>2],nfs_cp.words[nfs_cp.selected],nfs_cp.formats[nfs_cp.selected])||!nfs_cp_vertex(a,cell,0)||!nfs_cp_vertex(b,cell,tri?2:1)||!nfs_cp_vertex(c,cell,tri?3:2)){nfs_cp_cancel();return;}if(!nfs_cp.bound&&!nfs_cp.originalMode){drawTriangles();if(!nfs_cp_current()){nfs_cp_cancel();return;}glBindTexture(GL_TEXTURE_2D,nfs_cp.textures[nfs_cp.selected]);if(!nfs_cp_current()){nfs_cp_cancel();return;}nfs_cp.bound=1;}if(nfs_cp.originalMode)nfs_cp.bound=1;++nfs_cp.triangles;}
int nfs_private_child_photo_end(uint32_t family,uint64_t serial){int okay=nfs_cp.active&&nfs_cp_current()&&family==nfs_cp.domain.family&&serial==nfs_cp.domain.serial&&nfs_cp.selects==100&&nfs_cp.triangles==200;nfs_cp_cancel();return okay&&nfs_cp_current();}
static int nfs_child_photo_gpu_batch(const NfsChildPhotoDomain*d,int x,int y,unsigned mirrored,unsigned count,uint32_t*texture){if(!texture||!count||count>200||mirrored>200-count||!nfs_cp.active||!nfs_cp.bound||!nfs_cp_target()||!nfs_cp_same_domain(d)||nfs_cp.x!=x||nfs_cp.y!=y||nfs_cp.selected>=100||mirrored+count!=nfs_cp.triangles)return 0;*texture=nfs_cp.originalMode?nfs_cp.native[nfs_cp.selected]:nfs_cp.textures[nfs_cp.selected];return *texture&&nfs_cp_current();}

int nfs_private_child_photo_begin(uint32_t family,uint64_t serial,int32_t x,int32_t y){GLint f=0;GLboolean live=0;nfs_cp_cancel();if(!nfs_cp_current()||nfs_pp.active||family!=nfs_cp.domain.family||serial!=nfs_cp.domain.serial||x< -1024||x>1024||y!=316||g_renderBuffer!=GR_BUFFER_BACKBUFFER||!g_textureEnabled||g_fogEnabled)return 0;if(!nfs_cp_current())return 0;glGetIntegerv(GL_FRAMEBUFFER_BINDING,&f);if(!nfs_cp_current()||(GLuint)f!=g_framebuffer)return 0;

static int nfs_cp_pixels(TextureInfo*ti,const uint16_t*words,unsigned format){if(!ti||!ti->id||ti->hdDigits||ti->size!=32||ti->fmt!=format||!ti->data||!words)return 0;for(unsigned k=0;k<1024;++k){uint16_t actual;unsigned w=words[k],expected=format==GR_TEXFMT_ARGB_1555?((w<<1)|(w>>15))&65535:((w<<4)|(w>>12))&65535;memcpy(&actual,ti->data+k*2,2);if(actual!=expected)return 0;}return 1;}
static int nfs_cp_upload_current(const NfsChildPhotoAnimation*v){return v&&v->owner&&v->current&&v->current(v->owner)&&nfs_cp_context()&&nfs_menu_transition_source_life_current(v->game,v->sourceLife);}

static int nfs_cp_same_domain(const NfsChildPhotoDomain*d){const NfsChildPhotoDomain*s=&nfs_cp.domain;return d&&d->serial==s->serial&&d->family==s->family&&d->form==s->form&&d->game==s->game&&d->sourceLife==s->sourceLife&&d->sourceCatalog==s->sourceCatalog&&d->archive==s->archive&&d->epoch==s->epoch;}
static int nfs_cp_target(void){GLint f=0;if(!nfs_cp_current()||g_renderBuffer!=GR_BUFFER_BACKBUFFER||g_framebuffer!=nfs_cp.nativeFbo||g_framebufferTexture!=nfs_cp.nativeColor||g_framebufferDepth!=nfs_cp.nativeDepth||g_framebufferHeight!=(int)nfs_cp.nativeHeight)return 0;glGetIntegerv(GL_FRAMEBUFFER_BINDING,&f);return nfs_cp_current()&&(GLuint)f==nfs_cp.nativeFbo;}
static void nfs_cp_unbind(void){if(nfs_cp.bound&&nfs_cp_context()){drawTriangles();if(!nfs_cp.originalMode&&nfs_cp_context())glBindTexture(GL_TEXTURE_2D,nfs_cp.original);}nfs_cp.bound=0;}
static void nfs_cp_cancel(void){nfs_cp_unbind();nfs_cp.active=0;}
static void nfs_cp_drop_owner(void){if(nfs_cp.owner&&nfs_cp.release)nfs_cp.release(nfs_cp.owner);nfs_cp.owner=NULL;nfs_cp.release=NULL;nfs_cp.current=NULL;memset(&nfs_cp.domain,0,sizeof nfs_cp.domain);nfs_cp.generation=0;}
static void nfs_cp_created(void){memset(&nfs_cp,0,sizeof nfs_cp);nfs_cp.context=nfs_logo_provenance.context;nfs_cp.identity=(uintptr_t)g_glCtx;nfs_cp.thread=(uintptr_t)SDL_GetCurrentThreadID();}

static int nfs_cp_context(void){return nfs_cp.context&&nfs_cp.context==nfs_logo_provenance.context&&nfs_cp.identity==(uintptr_t)g_glCtx&&nfs_cp.thread==(uintptr_t)SDL_GetCurrentThreadID()&&g_glCtx&&SDL_GL_GetCurrentContext()==g_glCtx&&nfs_logo_provenance.alive&&!nfs_logo_provenance.disabled;}

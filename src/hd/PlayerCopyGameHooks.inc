  if((site==Site::Lazy?!l->iteration:l->iteration!=0)||!live::archiveCurrent(*l)){clear(*l);return;}auto group=live::activeSidebarGroupSerial(*l);std::shared_ptr<const nfs_player_initial_sidebar::Proof>initial;if(!group&&(site==Site::Initial||site==Site::Refresh)&&live::initialSidebarCurrent(*l)&&l->pendingInitialSidebar->binding().captionEvent.sequence<l->base.event.sequence){initial=l->pendingInitialSidebar;group=initial->origin()->group().serial;}if(!group){clear(*l);return;}

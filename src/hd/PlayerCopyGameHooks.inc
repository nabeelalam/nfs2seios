  if(!live::readPlane(c.pre)||!nfs_small_logo_live::target(c.pre.target,640)||!nfs_background_scene_cpu::retainedBaseTarget(l->base.post.target,c.pre.target)){reject(*s,Failure::Target);return;}if(!source(c,false)){reject(*s,Failure::Source);return;}

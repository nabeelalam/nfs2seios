static void nfs_graphics_dialog_forget(NfsGraphicsDialogWordGpu*s){memset(s,0,sizeof *s);}
#define NFS_GD_GL(call) do{if(!nfs_nested_caption_current(t))goto lost;call;if(!nfs_nested_caption_current(t))goto lost;}while(0)
static int nfs_graphics_dialog_retire(NfsGraphicsDialogWordGpu*s,const NfsBackgroundSceneStage*t,int owner){unsigned i;if(owner&&t&&s->generation==t->generation&&nfs_nested_caption_current(t)){if(s->program){NFS_GD_GL(glDeleteProgram(s->program));}for(i=0;i<8;++i)if(s->textures[i]){NFS_GD_GL(glDeleteTextures(1,s->textures+i));}}nfs_graphics_dialog_forget(s);return 1;lost:nfs_graphics_dialog_forget(s);return 0;}
static int nfs_graphics_dialog_ready(NfsGraphicsDialogWordGpu*s,const NfsGraphicsDialogWordsView*v,const NfsSoftwareTextLayerView*text,const NfsBackgroundSceneStage*t){unsigned i;GLboolean alive;unsigned char key[32];if(!s||!nfs_nested_caption_current(t)||!nfs_graphics_dialog_valid(v,text)||nfs_graphics_dialog_empty(v)||s->generation!=t->generation||!s->program||s->matrix<0||s->sampler<0)return 0;nfs_graphics_dialog_key(v,text,key);if(memcmp(key,s->key,32))return 0;NFS_GD_GL(alive=glIsProgram(s->program));if(!alive)return 0;for(i=0;i<8;++i){if(!s->textures[i])return 0;NFS_GD_GL(alive=glIsTexture(s->textures[i]));if(!alive)return 0;}return 1;lost:nfs_graphics_dialog_forget(s);return 0;}

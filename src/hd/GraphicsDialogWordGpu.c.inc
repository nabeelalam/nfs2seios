 NFS_GD_KEY(text->vertexCount);for(i=0;i<8;++i){const NfsGraphicsDialogWordImageView*a=v->images+i;NFS_GD_KEY(a->word);NFS_GD_KEY(a->width);NFS_GD_KEY(a->height);memcpy(b+used,a->sha256,32);used+=32;}for(i=0;i<16;++i){const NfsGraphicsDialogWordPlacement*a=v->placements+i;NFS_GD_KEY(a->word);NFS_GD_KEY(a->color565);NFS_GD_KEY(a->vertexFirst);NFS_GD_KEY(a->vertexCount);NFS_GD_KEY(a->left);NFS_GD_KEY(a->top);NFS_GD_KEY(a->right);NFS_GD_KEY(a->bottom);}nfs_texture_sha256(b,used,out);

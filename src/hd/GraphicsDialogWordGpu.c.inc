 {const NfsSoftwareTextVertex a={p->left,p->top,0,0,r,green,blue,1},b0={p->left,p->bottom,0,1,r,green,blue,1},c={p->right,p->top,1,0,r,green,blue,1},d={p->right,p->bottom,1,1,r,green,blue,1};q[0]=a;q[1]=b0;q[2]=c;q[3]=c;q[4]=b0;q[5]=d;}
 ok=nfs_graphics_dialog_vertices(s->program,s->textures[p->word-1],s->matrix,s->sampler,q,6,t);if(ok<0)goto lost;cursor=p->vertexFirst+p->vertexCount;}if(ok&&cursor<text->vertexCount)ok=nfs_graphics_dialog_vertices(font->program,font->texture,font->matrix,font->sampler,text->vertices+cursor,text->vertexCount-cursor,t);if(ok<0)goto lost;if(!nfs_nested_caption_restore(&saved,t))goto lost;return ok;lost:nfs_graphics_dialog_forget(s);return 0;}

static int nfs_graphics_dialog_vertices(GLuint program,GLuint texture,GLint matrix,GLint sampler,const NfsSoftwareTextVertex*vertices,size_t count,const NfsBackgroundSceneStage*t){unsigned i;GLenum error;if(!count)return 1;for(i=0;i<8;++i){NFS_GD_GL(glDisable(nfs_frame_caps[i]));}NFS_GD_GL(glColorMask(1,1,1,1));NFS_GD_GL(glDepthMask(GL_FALSE));NFS_GD_GL(glActiveTexture(GL_TEXTURE0));NFS_GD_GL(glBindBuffer(GL_ARRAY_BUFFER,0));NFS_GD_GL(glUseProgram(program));NFS_GD_GL(glUniformMatrix4fv(matrix,1,GL_FALSE,t->sampling.projection));NFS_GD_GL(glUniform1i(sampler,0));NFS_GD_GL(glBindTexture(GL_TEXTURE_2D,texture));NFS_GD_GL(glEnableVertexAttribArray(0));NFS_GD_GL(glEnableVertexAttribArray(1));NFS_GD_GL(glDisableVertexAttribArray(2));NFS_GD_GL(glDisableVertexAttribArray(3));NFS_GD_GL(glVertexAttribPointer(0,4,GL_FLOAT,GL_FALSE,sizeof(NfsSoftwareTextVertex),vertices));NFS_GD_GL(glVertexAttribPointer(1,4,GL_FLOAT,GL_FALSE,sizeof(NfsSoftwareTextVertex),&vertices[0].r));if(!nfs_nested_caption_blend(t,1))return -1;NFS_GD_GL(glDrawArrays(GL_TRIANGLES,0,(GLsizei)count));NFS_GD_GL(error=glGetError());return error==GL_NO_ERROR;lost:return -1;}

static int nfs_graphics_dialog_empty(const NfsGraphicsDialogWordsView*v){unsigned i,j;if(!v||v->schema||v->count)return 0;for(i=0;i<8;++i){const NfsGraphicsDialogWordImageView*a=v->images+i;if(a->word||a->width||a->height||a->rgba||a->bytes)return 0;for(j=0;j<32;++j)if(a->sha256[j])return 0;}for(i=0;i<16;++i){const NfsGraphicsDialogWordPlacement*a=v->placements+i;if(a->word||a->color565||a->vertexFirst||a->vertexCount||a->left||a->top||a->right||a->bottom)return 0;}return 1;}
static int nfs_graphics_dialog_valid(const NfsGraphicsDialogWordsView*v,const NfsSoftwareTextLayerView*text){static const unsigned widths[8]={90,105,120,76,33,35,51,68},counts[8]={78,90,96,66,30,24,36,48},lefts[8]={336,321,306,350,393,391,466,358},tops[8]={144,170,196,222,274,317,317,105};unsigned i,j;size_t end=0;unsigned char sha[32];if(nfs_graphics_dialog_empty(v))return 1;if(!v||!text||v->schema!=1||v->count!=16||!text->vertices||!text->vertexCount||text->vertexCount%6)return 0;for(i=0;i<8;++i){const NfsGraphicsDialogWordImageView*a=v->images+i;if(a->word!=i+1||a->width!=widths[i]*4||a->height!=128||a->bytes!=(size_t)a->width*128*4||!a->rgba||memcmp(a->sha256,nfs_graphics_dialog_word_sha256[i],32)||!nfs_texture_sha256(a->rgba,a->bytes,sha)||memcmp(sha,a->sha256,32))return 0;for(j=0;j<2;++j){const NfsGraphicsDialogWordPlacement*b=v->placements+2*i+j;unsigned shadow=j==0;if(b->word!=i+1||b->vertexFirst%6||b->vertexCount!=counts[i]||b->vertexFirst<end||b->vertexFirst>text->vertexCount||b->vertexCount>text->vertexCount-b->vertexFirst||b->left!=(float)(lefts[i]+shadow)||b->top!=(float)(tops[i]+shadow)||b->right!=(float)(lefts[i]+widths[i]+shadow)||b->bottom!=(float)(tops[i]+32+shadow)||(shadow?b->color565!=1:(i==7?b->color565!=3998:(b->color565!=37904&&b->color565!=65535))))return 0;end=b->vertexFirst+b->vertexCount;}}return 1;}
static void nfs_graphics_dialog_key(const NfsGraphicsDialogWordsView*v,const NfsSoftwareTextLayerView*text,unsigned char out[32]){unsigned char b[2048];size_t used=0;unsigned i;

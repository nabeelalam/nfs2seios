}
/* Does not change projection: the responsive caller may set its centered matrix. */
static int nfs_bg_opponent_preview_draw(NfsBackgroundSceneCompositor*s,const NfsOpponentSceneFrameView*v,const NfsNativeLogoTargetProof*p){return v&&nfs_bg_preview_draw(s,&v->preview,p);}
typedef struct NfsOpponentSceneImageKey {NfsBackgroundSceneImageKey base;uint64_t artGeneration;uintptr_t artIdentity;uint32_t selection,previewSchema,artWidth,artHeight;}NfsOpponentSceneImageKey;

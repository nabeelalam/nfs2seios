static int nfs_bg_opponent_view(const NfsOpponentSceneFrameView*v){
 NfsSoftwareTextStage stage;float caption[4],logos[4];NfsLogoVertex vertices[18];size_t used=0;
 if(!v||v->schema!=NFS_OPPONENT_SCENE_RUNTIME_SCHEMA||!nfs_bg_preview_view(&v->preview)||v->scene.tailKind!=NFS_BACKGROUND_TAIL_OPPONENT_CAPTION||!nfs_bg_view_common(&v->scene)||v->caption.logicalWidth!=343||v->caption.logicalHeight!=480)return 0;

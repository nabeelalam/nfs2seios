 {const char*flag=getenv("NFS_PRIVATE_OPPONENT_DIAG");static unsigned seen[16]={};const unsigned key=opponent->previewSelection<16?opponent->previewSelection:15;if(flag&&flag[0]=='1'&&!flag[1]&&seen[key]<2){unsigned j;++seen[key];fprintf(stderr,"OPPONENT ART RENDER selection=%u schema=%u artGeneration=%llu retainedIdentity=%u logical=%d,%d,%u,%u authored=%ux%u sha=",opponent->previewSelection,opponent->preview.schema,(unsigned long long)opponent->previewArtGeneration,(unsigned)(opponent->previewArtIdentity!=0),opponent->preview.left,opponent->preview.top,opponent->preview.width,opponent->preview.height,opponent->preview.authoredWidth,opponent->preview.authoredHeight);for(j=0;j<32;++j)fprintf(stderr,"%02x",opponent->preview.authoredSha256[j]);fprintf(stderr,"\n");}}

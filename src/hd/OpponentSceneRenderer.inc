static int nfs_bg_opponent_key(const NfsBackgroundSceneCompositor*s,const NfsOpponentSceneFrameView*opponent,NfsBackgroundSceneImageKey*k){k->previewTexture=s->previewTexture;k->previewLeft=opponent->preview.left;k->previewTop=opponent->preview.top;k->previewWidth=opponent->preview.width;k->previewHeight=opponent->preview.height;memcpy(k->previewSha256,s->previewSha256,32);memcpy(k->previewCoverageSha256,s->previewCoverageSha256,32);k->captionProgram=s->caption.program;k->captionTexture=s->caption.texture;k->captionIdentity=s->caption.fontIdentity;k->captionVertices=opponent->caption.vertexCount;memcpy(k->captionFontSha256,s->caption.fontSha256,32);if(!nfs_texture_sha256((const unsigned char*)opponent->caption.vertices,opponent->caption.vertexCount*sizeof(NfsSoftwareTextVertex),k->captionVerticesSha256))return 0;return 1;}

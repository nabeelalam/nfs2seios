inline void finish(Intent&i){if(!i.beginConsumed||i.finishAttempted)return;if(!i.serial||activeRequest()!=i.serial){cancel(i);return;}nfs::check_worker_stop();i.finishAttempted=true;const auto owned=i.owned;const auto uploaded=i.uploaded;const bool retained=i.retained;const uint64_t serial=i.serial;const auto receipt=nfs::enqueue_owned_renderer([owned,uploaded,retained,serial](){(void)owned;if(uploaded){NfsMainUploadedSeal seal{};const int ok=nfs_private_setup_uploaded_finish(serial,&seal);if(!retained){uploaded->seal=seal;uploaded->sealed=ok!=0;uploaded->completion.store(true,std::memory_order_release);}return int32_t(ok);}return int32_t(nfs_private_setup_scene_finish(serial));});if(receipt!=nfs::OwnedRendererAcceptance::Consumed)throw std::logic_error("background scene finish changed renderer owner");if(uploaded)nfs_setup_uploaded_source::completed(uploaded);i.finishConsumed=true;activeRequest()=0;nfs::check_worker_stop();}

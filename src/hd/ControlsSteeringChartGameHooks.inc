inline bool sourceCurrent(State&s)noexcept{std::array<uint8_t,chart::Builder::sourceSize>now{};return s.sourceBytes.size()==now.size()&&read(s.source,now.data(),now.size())&&!std::memcmp(now.data(),s.sourceBytes.data(),now.size());}

typedef struct NfsBgSaved {NfsFrameSaved common;GLint depthFunc,scissor[4];GLboolean depthMask;GLfloat depthClear;}NfsBgSaved;
static void nfs_bg_save(NfsBgSaved*s){nfs_frame_save(&s->common);glGetIntegerv(GL_DEPTH_FUNC,&s->depthFunc);glGetIntegerv(GL_SCISSOR_BOX,s->scissor);glGetBooleanv(GL_DEPTH_WRITEMASK,&s->depthMask);glGetFloatv(GL_DEPTH_CLEAR_VALUE,&s->depthClear);}
static void nfs_bg_restore(const NfsBgSaved*s){glDepthFunc(s->depthFunc);glDepthMask(s->depthMask);glClearDepthf(s->depthClear);glScissor(s->scissor[0],s->scissor[1],s->scissor[2],s->scissor[3]);nfs_frame_restore(&s->common);}
void nfs_bg_scene_cancel(NfsBackgroundSceneCompositor*s){if(s){s->pendingSerial=0;s->pendingImageRevision=0;s->pendingTailKind=0;}}
static void nfs_bg_invalidate(NfsBackgroundSceneCompositor*s,unsigned slot){s->imageReady[slot]=0;s->imageRevision[slot]=0;if(s->pendingSerial&&s->pendingSlot==slot)nfs_bg_scene_cancel(s);}
static void nfs_bg_forget(NfsBackgroundSceneCompositor*s){s->generation=s->ownerGeneration=0;s->program=s->copyProgram=0;memset(s->textures,0,sizeof s->textures);memset(s->color,0,sizeof s->color);memset(s->fbo,0,sizeof s->fbo);memset(s->width,0,sizeof s->width);memset(s->height,0,sizeof s->height);memset(s->imageReady,0,sizeof s->imageReady);memset(s->imageRevision,0,sizeof s->imageRevision);memset(s->keys,0,sizeof s->keys);memset(s->art,0,sizeof s->art);memset(s->regions,0,sizeof s->regions);s->matrix=s->sampler=s->opacity=s->copySampler=-1;s->lastBeginKind=s->pendingSlot=s->nextSlot=0;s->lastImageRevision=0;nfs_bg_scene_cancel(s);}
int nfs_bg_scene_context_created(NfsBackgroundSceneCompositor*s,uint64_t g){if(!s||!g||g<=s->lastGeneration||s->generation||s->ownerGeneration||!nfs_logo_gpu_context_created(&s->logo,g))return 0;if(!nfs_soft_gpu_context_created(&s->caption,g)){nfs_logo_gpu_context_retired(&s->logo,g,0);return 0;}nfs_bg_forget(s);s->generation=s->lastGeneration=g;return 1;}
void nfs_bg_scene_context_retired(NfsBackgroundSceneCompositor*s,uint64_t g,int owner){if(!s||!g||g!=s->generation)return;if(owner&&s->ownerGeneration==g){if(s->program)glDeleteProgram(s->program);if(s->copyProgram)glDeleteProgram(s->copyProgram);glDeleteTextures(5,s->textures);glDeleteTextures(2,s->color);glDeleteFramebuffers(2,s->fbo);}nfs_logo_gpu_context_retired(&s->logo,g,owner);nfs_soft_gpu_context_retired(&s->caption,g,owner);nfs_bg_forget(s);}
static int nfs_bg_ready(const NfsBackgroundSceneCompositor*s){unsigned i;if(!s||!s->generation||s->ownerGeneration!=s->generation||!s->program||!s->copyProgram||s->matrix<0||s->sampler<0||s->opacity<0||s->copySampler<0||!glIsProgram(s->program)||!glIsProgram(s->copyProgram)||!nfs_logo_ready(&s->logo))return 0;for(i=0;i<5;++i)if(!s->textures[i]||!glIsTexture(s->textures[i])||!s->art[i].identity)return 0;return 1;}
static GLuint nfs_bg_program(const char*v,const char*f,const char*attribute){GLuint vs=0,fs=0,p=0;GLint linked=0;vs=nfs_text_gpu_shader(GL_VERTEX_SHADER,v);if(!vs)return 0;fs=nfs_text_gpu_shader(GL_FRAGMENT_SHADER,f);if(fs){p=glCreateProgram();if(p){glAttachShader(p,vs);glAttachShader(p,fs);glBindAttribLocation(p,0,attribute);glLinkProgram(p);glGetProgramiv(p,GL_LINK_STATUS,&linked);}}glDeleteShader(vs);if(fs)glDeleteShader(fs);if(!linked||glGetError()!=GL_NO_ERROR){if(p)glDeleteProgram(p);return 0;}return p;}
int nfs_bg_scene_prepare(NfsBackgroundSceneCompositor*s){NfsBackgroundSceneTexture art[5];NfsBackgroundSceneWord regions[12];NfsSmallLogoArt logo;NfsSmallLogoRegion lr[5];NfsBgSaved saved;GLuint textures[5]={0},program=0,copy=0;GLint matrix=-1,sampler=-1,opacity=-1,copySampler=-1,maxSize=0;unsigned i;int ok=0;

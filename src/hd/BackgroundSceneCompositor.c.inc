 static const char vertex[]="attribute vec4 vertex;uniform mat4 matrix;varying highp vec2 uv;void main(){gl_Position=matrix*vec4(vertex.xy,1,1);uv=vertex.zw;}";
 static const char fragment[]="precision highp float;uniform sampler2D image;uniform float opacity;varying highp vec2 uv;void main(){gl_FragColor=texture2D(image,uv)*opacity;}";
 static const char copyV[]="attribute vec4 vertex;varying highp vec2 uv;void main(){gl_Position=vec4(vertex.xy,0,1);uv=vertex.zw;}";
 static const char copyF[]="precision highp float;uniform sampler2D image;varying highp vec2 uv;void main(){gl_FragColor=texture2D(image,uv);}";
 if(!s||!s->generation||(s->ownerGeneration&&s->ownerGeneration!=s->generation))return 0;
 for(i=0;i<5;++i)if(!nfs_private_background_scene_texture(i,art+i)||!art[i].pixels||art[i].schema!=1||art[i].role!=i||art[i].width!=widths[i]||art[i].height!=heights[i]||art[i].bytes!=(size_t)widths[i]*heights[i]*4||art[i].premultiplied!=1||art[i].opacityBaked||!art[i].identity||(i<2&&!art[i].opaque))return 0;
 for(i=0;i<12;++i){NfsBackgroundSceneWord*r=regions+i;if(!nfs_private_background_scene_word(i+1,r)||r->schema!=1||r->sourceRole!=i+1||r->textureRole<3||r->textureRole>4||r->scale!=4||!r->width||!r->height||!r->logicalWidth||r->logicalWidth>640||!r->logicalHeight||r->logicalHeight>480||(uint64_t)r->width!=(uint64_t)r->logicalWidth*4||(uint64_t)r->height!=(uint64_t)r->logicalHeight*4||r->x<2||r->y<2||(uint64_t)r->x+r->width+2>widths[r->textureRole]||(uint64_t)r->y+r->height+2>heights[r->textureRole])return 0;}
 if(nfs_bg_ready(s)){for(i=0;i<5;++i)if(s->art[i].identity!=art[i].identity||memcmp(s->art[i].sha256,art[i].sha256,32))return 0;return !memcmp(s->regions,regions,sizeof regions);}
 for(i=0;i<5;++i){unsigned char sha[32];size_t k;if(!nfs_texture_sha256(art[i].pixels,art[i].bytes,sha)||memcmp(sha,art[i].sha256,32))return 0;for(k=0;k<art[i].bytes;k+=4)if(art[i].pixels[k]>art[i].pixels[k+3]||art[i].pixels[k+1]>art[i].pixels[k+3]||art[i].pixels[k+2]>art[i].pixels[k+3]||(i<2&&art[i].pixels[k+3]!=255))return 0;}
 if(!nfs_private_small_logo_art(&logo))return 0;for(i=0;i<5;++i)if(!nfs_private_small_logo_region(i,lr+i))return 0;if(!nfs_logo_gpu_prepare(&s->logo,&logo,lr))return 0;

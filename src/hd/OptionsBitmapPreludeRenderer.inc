static void nfs_options_bitmap_renderer_other(void){if(nfs_options_bitmap_renderer.view.serial)nfs_options_bitmap_cancel("other-original-operation");}
static void nfs_options_bitmap_renderer_upload_begin(TextureInfo*ti){NfsAudioNativeStamp stamp;if(!nfs_options_bitmap_renderer.view.serial)return;if(nfs_options_bitmap_renderer.uploadPending||!nfs_options_bitmap_stamp(&stamp)||!nfs_audio_native_transition(&nfs_options_bitmap_renderer.pass,&stamp)||nfs_options_bitmap_renderer.pass.phase!=1||!ti){nfs_options_bitmap_cancel("upload-begin");return;}nfs_options_bitmap_renderer.uploadPending=1;nfs_options_bitmap_renderer.uploadTexture=ti;}

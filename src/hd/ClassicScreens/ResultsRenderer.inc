 static const char fragment[]=
 "precision highp float;uniform sampler2D image;uniform float row;varying highp vec2 uv;"
 "float line(float d,float w){return 1.-smoothstep(w,w+.65,abs(d));}"
 "void main(){vec2 p=uv*vec2(435.,77.);"
 "float glow=exp(-pow((p.x-35.)/175.,2.)-pow((p.y-77.)/64.,2.));"
 "vec3 paper=vec3(.086,.024,.020)+glow*vec3(.392,.055,.039);"
 "float grid=max(line(mod(p.x+1.,43.)-1.,.25),line(mod(p.y+1.,20.)-1.,.25));"
 "grid=max(grid,line(p.x-133.,.35));"
 "float radius=length((p-vec2(133.,-42.))*vec2(1.,1.));"
 "grid=max(grid,max(line(radius-91.,.35),line(radius-141.,.35))*.65);"
 "float tine=0.;for(int i=0;i<6;i++){float yy=4.+float(i)*10.;float xx=104.-float(i)*10.;"
 "float edge=max(line(p.y-yy,.35)*step(11.,p.x)*step(p.x,xx),line(p.y-(yy+7.),.35)*step(11.,p.x)*step(p.x,xx-7.));"
 "edge=max(edge,line((p.x+p.y)-(xx+yy),.45)*step(yy,p.y)*step(p.y,yy+7.));tine=max(tine,edge);}"
 "paper*=1.-.24*max(grid,tine);"
 "vec2 tuv=vec2(uv.x,(uv.y+row)/6.);float a=texture2D(image,tuv).a;"
 "float upper=texture2D(image,tuv-vec2(0.,1./1848.)).a;"
 "float lower=texture2D(image,tuv+vec2(0.,1./1848.)).a;"
 "vec3 face=mix(vec3(.51,.18,.14),vec3(.29,.085,.069),uv.y);"

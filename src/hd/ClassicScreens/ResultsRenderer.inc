// Whole opaque authored435x77 band. This intentionally covers the old baked title,
// then source-driven body text is drawn afterwards in the existing owned stage.
static int nfs_results_heading_prepare(void){
 GLuint vs=0,fs=0,program=0,texture=0;GLint linked=0,sampler=-1,row=-1,maxSize=0,unpack=0;NfsBgSaved saved;int ok=0;unsigned char*alpha=NULL;size_t at=0,k=0;unsigned char digest[32];

 done:free(alpha);alpha=NULL;if(!nfs_results_context(nfs_results_renderer.generation,nfs_results_renderer.context)){nfs_results_abandon();return 0;}if(vs)glDeleteShader(vs);if(fs)glDeleteShader(fs);if(!ok){if(program)glDeleteProgram(program);if(texture)glDeleteTextures(1,&texture);}glPixelStorei(GL_UNPACK_ALIGNMENT,unpack);nfs_bg_restore(&saved);if(!ok)return 0;

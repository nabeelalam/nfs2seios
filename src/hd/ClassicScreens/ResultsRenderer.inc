static int nfs_results_context(uint64_t generation,uintptr_t context){return generation&&nfs_results_renderer.generation==generation&&nfs_results_renderer.context==context&&nfs_results_renderer.thread==NFS_RESULTS_THREAD_TOKEN()&&g_glCtx&&(uintptr_t)g_glCtx==context&&SDL_GL_GetCurrentContext()==g_glCtx&&nfs_logo_provenance.alive&&nfs_logo_provenance.context==generation;}

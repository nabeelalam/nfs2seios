 if(nfs_soft_gpu_ready(s))return s->fontIdentity==f->identity&&!memcmp(s->fontSha256,f->sha256,32);
 if(!nfs_texture_sha256(f->alpha,f->bytes,sha)||memcmp(sha,f->sha256,32))return 0;glGetIntegerv(GL_MAX_TEXTURE_SIZE,&maxSize);if(maxSize<1024||glGetError()!=GL_NO_ERROR)return 0;nfs_frame_save(&saved);
 vs=nfs_text_gpu_shader(GL_VERTEX_SHADER,vertex);if(!vs)goto done;fs=nfs_text_gpu_shader(GL_FRAGMENT_SHADER,fragment);if(!fs)goto done;program=glCreateProgram();if(!program)goto done;glAttachShader(program,vs);glAttachShader(program,fs);glBindAttribLocation(program,0,"vertex");glBindAttribLocation(program,1,"color");glLinkProgram(program);glGetProgramiv(program,GL_LINK_STATUS,&linked);if(!linked)goto done;sampler=glGetUniformLocation(program,"image");matrix=glGetUniformLocation(program,"matrix");if(sampler<0||matrix<0)goto done;
 glActiveTexture(GL_TEXTURE0);glGenTextures(1,&texture);if(!texture)goto done;glBindTexture(GL_TEXTURE_2D,texture);nfs_frame_texture_params();glPixelStorei(GL_UNPACK_ALIGNMENT,1);glTexImage2D(GL_TEXTURE_2D,0,GL_ALPHA,1024,512,0,GL_ALPHA,GL_UNSIGNED_BYTE,f->alpha);if(!nfs_credits_context(s->generation,nfs_credits_renderer.context))goto done;ok=glGetError()==GL_NO_ERROR;

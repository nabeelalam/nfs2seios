static int nfs_credits_context(uint64_t generation,uintptr_t context){return generation&&nfs_credits_renderer.generation==generation&&nfs_credits_renderer.context==context&&nfs_credits_renderer.thread==NFS_CREDITS_THREAD_TOKEN()&&g_glCtx&&(uintptr_t)g_glCtx==context&&SDL_GL_GetCurrentContext()==g_glCtx&&nfs_logo_provenance.alive&&nfs_logo_provenance.context==generation;}
static void nfs_credits_trace(const char*event,const char*why){if(!nfs_logo_trace_enabled()||nfs_credits_renderer.traceLines>=256)return;++nfs_credits_renderer.traceLines;fprintf(stderr,"CREDITS NATIVE %s reason=%s request=%llu content=%llu size=%ux%u textVertices=%zu\n",event,why,(unsigned long long)nfs_credits_renderer.request,(unsigned long long)nfs_credits_renderer.view.content,nfs_credits_renderer.target.width,nfs_credits_renderer.target.height,nfs_credits_renderer.view.text.vertexCount);}
static void nfs_credits_clear_view(void){void*owner=nfs_credits_renderer.view.owner;void(*release)(void*)=nfs_credits_renderer.view.release;memset(&nfs_credits_renderer.view,0,sizeof nfs_credits_renderer.view);if(owner&&release)release(owner);}
static void nfs_credits_cancel(const char*why){if(nfs_credits_renderer.request)nfs_credits_trace("canceled",why);nfs_credits_clear_view();nfs_credits_renderer.request=0;}
static void nfs_credits_abandon(void){nfs_soft_gpu_context_retired(&nfs_credits_renderer.text,nfs_credits_renderer.text.generation,0);nfs_credits_renderer.color=nfs_credits_renderer.fbo=nfs_credits_renderer.clean=nfs_credits_renderer.copyProgram=0;nfs_credits_renderer.width=nfs_credits_renderer.height=nfs_credits_renderer.cleanWidth=nfs_credits_renderer.cleanHeight=0;nfs_credits_cancel("owner-lost");}
// A direct-native text screen legitimately changes depth/texture state and
// uses a partial scrolling scissor. Only actual context/FBO attachment geometry
// is required here; no Main/Audio native upload or depth-clear authority is borrowed.
static int nfs_credits_read_target(NfsNativeLogoTargetProof*out){unsigned w=0,h=0;NfsFrameLegacySampling sampling;if(!out||!nfs_credits_context(nfs_credits_renderer.generation,nfs_credits_renderer.context)||g_renderBuffer!=GR_BUFFER_BACKBUFFER||!nfs_logo_native_target_base(&w,&h,&sampling))return 0;memset(out,0,sizeof *out);out->framebuffer=g_framebuffer;out->width=w;out->height=h;out->contextGeneration=nfs_credits_renderer.generation;out->sampling=sampling;return 1;}
static int nfs_credits_target_equal(void){NfsNativeLogoTargetProof t;return nfs_credits_read_target(&t)&&!memcmp(&t,&nfs_credits_renderer.target,sizeof t);}
static int nfs_credits_font_prepare(NfsSoftwareTextGpu*s,const NfsSoftwareTextFontView*f){

static int nfs_loading_context(uint64_t generation,uintptr_t context){return generation&&nfs_loading_renderer.generation==generation&&nfs_loading_renderer.context==context&&nfs_loading_renderer.thread==NFS_LOADING_THREAD_TOKEN()&&g_glCtx&&(uintptr_t)g_glCtx==context&&SDL_GL_GetCurrentContext()==g_glCtx&&nfs_logo_provenance.alive&&nfs_logo_provenance.context==generation;}
static int nfs_loading_words_owner_current(void){return nfs_loading_context(nfs_loading_renderer.generation,nfs_loading_renderer.context);}

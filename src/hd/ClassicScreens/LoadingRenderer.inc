static void nfs_loading_renderer_created(void){uint64_t generation=nfs_logo_provenance.context;uintptr_t context=(uintptr_t)g_glCtx;if(!nfs_bg_feature()||!generation||!context||SDL_GL_GetCurrentContext()!=g_glCtx)return;nfs_loading_renderer.generation=generation;nfs_loading_renderer.context=context;nfs_loading_renderer.thread=NFS_LOADING_THREAD_TOKEN();nfs_loading_words_retire(&nfs_loading_renderer.words,0);nfs_loading_renderer.uploadPending=0;nfs_loading_clear_view();(void)nfs_audio_native_created(&nfs_loading_renderer.pass,generation,context,nfs_loading_renderer.thread);}

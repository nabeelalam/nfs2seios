// PRIVATE DEFAULT-OFF TITLE SWAP DIAGNOSTIC. No image capture or rendering changes.
static struct {NfsIntroLiveView source;NfsIntroArtView art;NfsNativeLogoTargetProof target;uintptr_t context,thread;uint64_t generation,request,content,swap;GLuint color,depth;unsigned pending,sealed,native,authored,commitAttempted,selected,done,lines;}nfs_td;
static int nfs_td_on(void){const char*p=getenv("NFS_PRIVATE_TITLE_SWAP_TRACE");return p&&p[0]=='1'&&!p[1];}
static void nfs_td_note(const char*event,unsigned reason,int success){const int saved=errno;if(nfs_td_on()&&nfs_td.lines++<16)fprintf(stderr,"TITLE SWAP event=%s reason=%u request=%llu content=%llu art=%llu native=%u authored=%u fbo=%u color=%u depth=%u context=%llu size=%ux%u output=%dx%d swap=%llu success=%d first=%u\n",event,reason,(unsigned long long)nfs_td.request,(unsigned long long)nfs_td.content,(unsigned long long)nfs_td.source.artGeneration,nfs_td.native,nfs_td.authored,nfs_td.target.framebuffer,nfs_td.color,nfs_td.depth,(unsigned long long)nfs_td.generation,nfs_td.target.width,nfs_td.target.height,winWidth,winHeight,(unsigned long long)nfs_td.swap,success,!nfs_td.done);errno=saved;}
static void nfs_td_release(void){void*p=nfs_td.source.owner;void(*release)(void*)=nfs_td.source.release;void*a=nfs_td.art.owner;void(*ar)(void*)=nfs_td.art.release;memset(&nfs_td.source,0,sizeof nfs_td.source);memset(&nfs_td.art,0,sizeof nfs_td.art);nfs_td.pending=nfs_td.sealed=nfs_td.selected=0;if(p&&release)release(p);if(a&&ar)ar(a);}
static int nfs_td_current(void){return nfs_td.pending&&nfs_intro_context(nfs_td.generation,nfs_td.context)&&nfs_td.thread==NFS_INTRO_THREAD_TOKEN();}
static int nfs_td_attachments(GLuint fbo,GLuint color,GLuint depth){GLint old=0,type=0,name=0;int ok=0;if(!nfs_td_current()||!fbo||!color||!depth)return 0;glGetIntegerv(GL_FRAMEBUFFER_BINDING,&old);glBindFramebuffer(GL_FRAMEBUFFER,fbo);glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE,&type);glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,&name);ok=type==GL_TEXTURE&&(GLuint)name==color;glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_DEPTH_ATTACHMENT,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE,&type);glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_DEPTH_ATTACHMENT,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,&name);ok=ok&&type==GL_RENDERBUFFER&&(GLuint)name==depth&&glCheckFramebufferStatus(GL_FRAMEBUFFER)==GL_FRAMEBUFFER_COMPLETE;glBindFramebuffer(GL_FRAMEBUFFER,(GLuint)old);return ok&&nfs_td_current();}
static void nfs_td_start(const NfsIntroLiveView*v){NfsNativeLogoTargetProof t;GLint old=0,type=0,color=0,depth=0;if(!nfs_td_on()||nfs_td.done)return;if(nfs_td.pending){nfs_td_note("refused",1,0);nfs_td_release();}if(!v||v->schema!=1||v->pixels!=307200||!v->request||!v->content||!v->owner||!v->retain||!v->release||!nfs_intro_read_target(&t,v->request)||!nfs_intro_sampling_supported(&t))return;v->retain(v->owner);nfs_td.source=*v;nfs_td.target=t;nfs_td.request=v->request;nfs_td.content=v->content;nfs_td.context=nfs_intro_renderer.context;nfs_td.generation=nfs_intro_renderer.generation;nfs_td.thread=NFS_INTRO_THREAD_TOKEN();nfs_td.native=nfs_td.authored=nfs_td.commitAttempted=0;nfs_td.pending=1;glGetIntegerv(GL_FRAMEBUFFER_BINDING,&old);glBindFramebuffer(GL_FRAMEBUFFER,t.framebuffer);glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE,&type);glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,&color);if(type!=GL_TEXTURE)color=0;glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_DEPTH_ATTACHMENT,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE,&type);glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,GL_DEPTH_ATTACHMENT,GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,&depth);if(type!=GL_RENDERBUFFER)depth=0;glBindFramebuffer(GL_FRAMEBUFFER,(GLuint)old);nfs_td.color=(GLuint)color;nfs_td.depth=(GLuint)depth;if(!nfs_td_attachments(t.framebuffer,nfs_td.color,nfs_td.depth)){nfs_td_note("refused",2,0);nfs_td_release();return;}nfs_td_note("attempt",0,0);}
static void nfs_td_seal(unsigned authored){if(!nfs_td.pending||nfs_td.sealed)return;if(!nfs_td_current()||!nfs_td_attachments(nfs_td.target.framebuffer,nfs_td.color,nfs_td.depth)){nfs_td_note("refused",3,0);nfs_td_release();return;}if(authored){if(!nfs_td.native||!nfs_intro_renderer.art.owner||!nfs_intro_renderer.art.retain||!nfs_intro_renderer.art.release){nfs_td_note("refused",4,0);nfs_td_release();return;}nfs_intro_renderer.art.retain(nfs_intro_renderer.art.owner);nfs_td.art=nfs_intro_renderer.art;nfs_td.authored=1;}nfs_td.sealed=1;nfs_td_note("sealed",authored?0:5,0);}
static void nfs_td_mutation(unsigned reason){if(nfs_td.pending&&nfs_td.sealed){nfs_td_note("invalidated",reason,0);nfs_td_release();}}
static void nfs_td_before(GLuint fbo,GLuint texture,GLuint sampled){if(!nfs_td_on())return;if(nfs_td.swap<UINT64_MAX)++nfs_td.swap;nfs_td.selected=0;if(!nfs_td.pending)return;GLint actualSampled=0;glGetIntegerv(GL_TEXTURE_BINDING_2D,&actualSampled);sampled=(GLuint)actualSampled;if(!nfs_td.sealed||!nfs_td_current()||fbo!=nfs_td.target.framebuffer||texture!=nfs_td.color||sampled!=texture||nfs_td.source.artGeneration!=nfs_intro_art_generation()||!nfs_td_attachments(fbo,texture,nfs_td.depth)){nfs_td_note("refused",6,0);nfs_td_release();return;}nfs_td.selected=1;}
static void nfs_td_after(int success){if(!nfs_td.selected)return;nfs_td_note(nfs_td.authored?"authored-present":(nfs_td.native&&!nfs_td.commitAttempted)?"native-present":"unresolved-present",0,success);if(success){nfs_td.done=1;nfs_td_release();}else nfs_td.selected=0;}

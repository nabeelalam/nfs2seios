 {const GLfloat a[]={l-pad,t-pad,0,0,l-pad,b+pad,0,1,r+pad,t-pad,1,0,r+pad,t-pad,1,0,l-pad,b+pad,0,1,r+pad,b+pad,1,1};memcpy(q,a,sizeof q);}glUniform4fv(nfs_ls_child_material.rect,1,s->bounds);glUniform4fv(nfs_ls_child_material.clip,1,s->clip);glUniform1f(nfs_ls_child_material.role,(float)s->role);if(s->role<3)glBindTexture(GL_TEXTURE_2D,nfs_ls_child_material.art[s->role-1]);glVertexAttribPointer(0,4,GL_FLOAT,GL_FALSE,0,q);glDrawArrays(GL_TRIANGLES,0,6);}

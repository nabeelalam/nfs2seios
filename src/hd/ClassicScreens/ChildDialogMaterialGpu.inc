static void nfs_ls_child_material_retire(int owner){if(owner){unsigned k;if(nfs_ls_child_material.program)glDeleteProgram(nfs_ls_child_material.program);for(k=0;k<2;++k)if(nfs_ls_child_material.art[k])glDeleteTextures(1,nfs_ls_child_material.art+k);}memset(&nfs_ls_child_material,0,sizeof nfs_ls_child_material);}

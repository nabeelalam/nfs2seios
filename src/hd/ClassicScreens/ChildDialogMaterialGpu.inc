static int nfs_ls_child_material_draw(const NfsLoadSaveChildView*v){size_t n;if(!v||v->shapeCount>128||(v->shapeCount&&!v->shapes))return 0;if(!v->shapeCount)return 1;if(!nfs_ls_child_material_prepare())return 0;nfs_frame_draw_state();glViewport(nfs_ls_child_renderer.target.sampling.viewport[0],nfs_ls_child_renderer.target.sampling.viewport[1],nfs_ls_child_renderer.target.sampling.viewport[2],nfs_ls_child_renderer.target.sampling.viewport[3]);glUseProgram(nfs_ls_child_material.program);glUniformMatrix4fv(nfs_ls_child_material.matrix,1,GL_FALSE,nfs_ls_child_renderer.target.sampling.projection);glUniform1f(nfs_ls_child_material.feather,fmaxf(.08f,.7f*640.f/nfs_ls_child_renderer.target.width));glUniform1i(nfs_ls_child_material.sampler,0);glActiveTexture(GL_TEXTURE0);glBindBuffer(GL_ARRAY_BUFFER,0);glEnableVertexAttribArray(0);glDisableVertexAttribArray(1);glDisableVertexAttribArray(2);glDisableVertexAttribArray(3);glEnable(GL_BLEND);glBlendEquationSeparate(GL_FUNC_ADD,GL_FUNC_ADD);glBlendFuncSeparate(GL_ONE,GL_ONE_MINUS_SRC_ALPHA,GL_ONE,GL_ONE_MINUS_SRC_ALPHA);

static int nfs_rb_crest(NfsRecordsBackdropGpu*s,unsigned track){const unsigned width=512,height=512;const size_t count=512u*512u;unsigned char*pixels=NULL;size_t at=0;unsigned left=512,top=512,right=0,bottom=0;int ok=0;if(track>=8)return 0;if(s->crests[track])return 1;pixels=(unsigned char*)malloc(count*4);if(!pixels)return 0;for(size_t i=0;i<nfs_rb_crest_run_counts[track];++i){const NfsRbColorRun*r=nfs_rb_crest_runs[track]+i;unsigned n=r->count,color=r->color;if(!n||n>count-at)goto done;for(unsigned k=0;k<n;++k){pixels[4*at]=(unsigned char)color;pixels[4*at+1]=(unsigned char)(color>>8);pixels[4*at+2]=(unsigned char)(color>>16);pixels[4*at+3]=(unsigned char)(color>>24);++at;}}if(at!=count)goto done;for(unsigned y=0;y<height;++y)for(unsigned x=0;x<width;++x)if(pixels[((size_t)y*width+x)*4+3]>8){if(x<left)left=x;if(y<top)top=y;if(x+1>right)right=x+1;if(y+1>bottom)bottom=y+1;}if(left>=right||top>=bottom)goto done;if(!nfs_rb_upload(s->crests+track,width,height,GL_RGBA,pixels))goto done;s->crestUv[track][0]=(float)left/width;s->crestUv[track][1]=(float)top/height;s->crestUv[track][2]=(float)right/width;s->crestUv[track][3]=(float)bottom/height;s->crestWidth[track]=right-left;s->crestHeight[track]=bottom-top;ok=1;done:free(pixels);return ok;}

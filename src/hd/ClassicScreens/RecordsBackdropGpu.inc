static void nfs_records_backdrop_retire(NfsRecordsBackdropGpu*s,const NfsBackgroundSceneStage*t,int owner){if(!s)return;if(owner&&nfs_rb_current(t)&&s->generation==t->generation&&s->context==t->contextIdentity){if(s->baseProgram)glDeleteProgram(s->baseProgram);if(s->copyProgram)glDeleteProgram(s->copyProgram);if(s->labels)glDeleteTextures(1,&s->labels);if(s->ghost)glDeleteTextures(1,&s->ghost);glDeleteTextures(8,s->crests);}memset(s,0,sizeof *s);}
static int nfs_rb_labels(NfsRecordsBackdropGpu*s){const size_t pixels=2048u*2048u;unsigned char*alpha=(unsigned char*)malloc(pixels);size_t at=0;int ok=0;if(!alpha)return 0;for(size_t i=0;i<sizeof(nfs_rb_label_runs)/sizeof(nfs_rb_label_runs[0]);i+=2){size_t n=nfs_rb_label_runs[i];unsigned v=nfs_rb_label_runs[i+1];if(!n||v>255||n>pixels-at)goto done;memset(alpha+at,(int)v,n);at+=n;}if(at!=pixels)goto done;ok=nfs_rb_upload(&s->labels,2048,2048,GL_ALPHA,alpha);done:free(alpha);return ok;}

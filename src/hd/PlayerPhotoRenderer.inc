#include "hd/PlayerPhotoAnimationAbi.h"
#include "hd/PlayerPhotoArtProvider.h"
// Private textures only. Original native textures/pixels/metadata are never
// edited. A triangle is eligible only after exact source-upload AND geometry
// admission; all native calls and original batch ordering remain in place.
static struct {uint64_t context,serial,art;uintptr_t identity,thread;GLuint textures[100],native[100];uint32_t addresses[100],formats[100];uint16_t words[100][1024];unsigned selects,triangles,selected,bound;int active,x,y;GLuint original;}nfs_pp;
static int nfs_pp_current(void){return nfs_pp.context&&nfs_pp.context==nfs_logo_provenance.context&&nfs_pp.identity==(uintptr_t)g_glCtx&&nfs_pp.thread==(uintptr_t)SDL_GetCurrentThreadID()&&g_glCtx&&SDL_GL_GetCurrentContext()==g_glCtx;}
static void nfs_pp_unbind(void){if(nfs_pp.bound&&nfs_pp_current()){drawTriangles();glBindTexture(GL_TEXTURE_2D,nfs_pp.original);}nfs_pp.bound=0;}
static void nfs_pp_cancel(void){nfs_pp_unbind();nfs_pp.active=0;}
static void nfs_pp_retired(int owner){if(owner&&nfs_pp_current()){nfs_pp_cancel();for(unsigned k=0;k<100;++k)if(nfs_pp.textures[k])glDeleteTextures(1,&nfs_pp.textures[k]);}memset(&nfs_pp,0,sizeof nfs_pp);}
static void nfs_pp_created(void){memset(&nfs_pp,0,sizeof nfs_pp);nfs_pp.context=nfs_logo_provenance.context;nfs_pp.identity=(uintptr_t)g_glCtx;nfs_pp.thread=(uintptr_t)SDL_GetCurrentThreadID();}
static int nfs_pp_pixels(TextureInfo*ti,const uint16_t*words,unsigned format){if(!ti||!ti->id||ti->hdDigits||ti->size!=32||ti->fmt!=format||!ti->data)return 0;for(unsigned k=0;k<1024;++k){unsigned w=words[k],v=((const uint16_t*)ti->data)[k];unsigned expected=format==GR_TEXFMT_ARGB_1555?((w<<1)|(w>>15))&65535:((w<<4)|(w>>12))&65535;if(v!=expected)return 0;}return 1;}
int nfs_private_player_photo_upload(const NfsPlayerPhotoAnimation*v){
 NfsBgSaved saved;int okay=0;nfs_pp_cancel();if(!v||!v->serial||v->count!=100||!v->tiles||!nfs_pp_current()||!v->generation||v->generation!=nfs_player_photo_art_generation())return 0;
 for(unsigned k=0;k<100;++k){const NfsPlayerPhotoTile*t=v->tiles+k;if(!t->original||!t->rgba||(t->format!=GR_TEXFMT_ARGB_1555&&t->format!=GR_TEXFMT_ARGB_4444)||t->address>sizeof(g_textureMem)-2048||t->address%4)return 0;TextureInfo*ti=&g_textures[t->address>>2];if(ti->data!=g_textureMem+t->address||!nfs_pp_pixels(ti,t->original,t->format))return 0;for(unsigned j=0;j<k;++j)if((((uint64_t)(t->address))<((uint64_t)(v->tiles[j].address))+2048&&((uint64_t)(v->tiles[j].address))<((uint64_t)(t->address))+2048)||ti->id==nfs_pp.native[j])return 0;nfs_pp.native[k]=ti->id;}
 nfs_bg_save(&saved);glActiveTexture(GL_TEXTURE0);for(unsigned k=0;k<100;++k){if(!nfs_pp.textures[k])glGenTextures(1,&nfs_pp.textures[k]);if(!nfs_pp.textures[k]||nfs_pp.textures[k]==g_framebufferTexture)goto done;for(unsigned j=0;j<100;++j)if(nfs_pp.textures[k]==nfs_pp.native[j])goto done;glBindTexture(GL_TEXTURE_2D,nfs_pp.textures[k]);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);glPixelStorei(GL_UNPACK_ALIGNMENT,1);glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,128,128,0,GL_RGBA,GL_UNSIGNED_BYTE,v->tiles[k].rgba);nfs_pp.addresses[k]=v->tiles[k].address;nfs_pp.formats[k]=v->tiles[k].format;memcpy(nfs_pp.words[k],v->tiles[k].original,2048);}
 okay=glGetError()==GL_NO_ERROR&&nfs_pp_current();done:nfs_bg_restore(&saved);if(!okay){nfs_pp.serial=0;return 0;}nfs_pp.serial=v->serial;nfs_pp.art=v->generation;return 1;
}
int nfs_private_player_photo_begin(uint64_t serial,int32_t x,int32_t y){GLint fbo=0;nfs_pp_cancel();if(!nfs_pp_current()||!serial||serial!=nfs_pp.serial||nfs_pp.art!=nfs_player_photo_art_generation()||x< -1024||x>1024||y!=316||g_renderBuffer!=GR_BUFFER_BACKBUFFER||!g_textureEnabled||g_fogEnabled)return 0;glGetIntegerv(GL_FRAMEBUFFER_BINDING,&fbo);if((GLuint)fbo!=g_framebuffer)return 0;for(unsigned k=0;k<100;++k){TextureInfo*ti=&g_textures[nfs_pp.addresses[k]>>2];if(!glIsTexture(nfs_pp.textures[k])||ti->id!=nfs_pp.native[k]||!nfs_pp_pixels(ti,nfs_pp.words[k],nfs_pp.formats[k]))return 0;}nfs_pp.x=x;nfs_pp.y=y;nfs_pp.selects=nfs_pp.triangles=0;nfs_pp.selected=100;nfs_pp.active=1;return 1;}
static void nfs_pp_select(unsigned tmu,uint32_t address,uint32_t parity,const GrTexInfo*info,TextureInfo*ti){
 // Native grTexSource already flushed the previous private-bound triangle batch
 // and rebound its own texture before this observer. No saved binding is reused.
 nfs_pp.bound=0;if(!nfs_pp.active)return;unsigned n=nfs_pp.selects,k=(n%2)*50+n/2;if(n>=100||nfs_pp.triangles!=n*2||!nfs_pp_current()||nfs_pp.art!=nfs_player_photo_art_generation()||tmu||parity!=3||!info||info->smallLod!=3||info->largeLod!=3||info->aspectRatio!=3||info->format!=nfs_pp.formats[k]||address!=nfs_pp.addresses[k]||!ti||ti->id!=nfs_pp.native[k]||!nfs_pp_pixels(ti,nfs_pp.words[k],nfs_pp.formats[k])){nfs_pp_cancel();return;}nfs_pp.original=ti->id;nfs_pp.selected=k;++nfs_pp.selects;
}
static int nfs_pp_vertex(const GrVertex*v,unsigned cell,unsigned corner){unsigned col=cell/5,row=cell%5;int right=corner==1||corner==2,bottom=corner>=2;return v&&v->x==(float)(nfs_pp.x+col*32+(right?32:0))+VertexSnap&&v->y==(float)(nfs_pp.y+row*32+(bottom?32:0))+VertexSnap&&v->r==255&&v->g==255&&v->b==255&&v->a==255&&v->oow==1&&v->tmuvtx[0].sow==(right?255:0)&&v->tmuvtx[0].tow==(bottom?255:0);}
static void nfs_pp_triangle(const GrVertex*a,const GrVertex*b,const GrVertex*c){if(!nfs_pp.active)return;unsigned n=nfs_pp.triangles/2,tri=nfs_pp.triangles%2,cell=n/2;GLint fbo=0;glGetIntegerv(GL_FRAMEBUFFER_BINDING,&fbo);if(n>=100||nfs_pp.selects!=n+1||nfs_pp.selected!=(n%2)*50+cell||!nfs_pp_current()||nfs_pp.art!=nfs_player_photo_art_generation()||(GLuint)fbo!=g_framebuffer||!g_textureEnabled||g_fogEnabled||!nfs_pp_pixels(&g_textures[nfs_pp.addresses[nfs_pp.selected]>>2],nfs_pp.words[nfs_pp.selected],nfs_pp.formats[nfs_pp.selected])||!nfs_pp_vertex(a,cell,0)||!nfs_pp_vertex(b,cell,tri?2:1)||!nfs_pp_vertex(c,cell,tri?3:2)){nfs_pp_cancel();return;}
 // Flush before changing texture binding; pending vertices always retain the
 // texture under which they were admitted. Original drawTriangle follows.
 if(!nfs_pp.bound){drawTriangles();glBindTexture(GL_TEXTURE_2D,nfs_pp.textures[nfs_pp.selected]);nfs_pp.bound=1;}++nfs_pp.triangles;
}
int nfs_private_player_photo_end(uint64_t serial){int okay=nfs_pp.active&&serial==nfs_pp.serial&&nfs_pp.selects==100&&nfs_pp.triangles==200&&nfs_pp_current();nfs_pp_cancel();if(nfs_logo_trace_enabled())fprintf(stderr,"PLAYER PHOTO animation %s serial=%llu selects=%u triangles=%u\n",okay?"published":"refused",(unsigned long long)serial,nfs_pp.selects,nfs_pp.triangles);return okay;}

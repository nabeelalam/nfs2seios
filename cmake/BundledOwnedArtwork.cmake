# Optional classic UI owner reconstruction. Include after all app/test targets.
option(NFS_CLASSIC_BUNDLE_OWNED_ARTWORK "Bundle authored owner template for classic UI" ${NFS_CLASSIC_UI})
option(NFS_CLASSIC_DEFER_OWNER_TEMPLATE "Build unsigned classic base without personal artwork; exact post-build injection required" OFF)
if(NFS_CLASSIC_DEFER_OWNER_TEMPLATE AND NOT NFS_CLASSIC_BUNDLE_OWNED_ARTWORK)
  message(FATAL_ERROR "Deferred owner template requires the classic owned-artwork loader")
endif()
# Prepared classic slideshow units need compression even when artwork is supplied
# separately instead of bundled. Apple continues to use its existing SDK library.
if(NFS_CLASSIC_UI)
  find_package(ZLIB QUIET)
  if(NOT ZLIB_FOUND)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
      message(FATAL_ERROR "The selected Apple SDK must provide zlib")
    endif()
    include(FetchContent)
    # Official zlib 1.3.2 release and publisher SHA-256; project-local only.
    set(ZLIB_BUILD_TESTING OFF CACHE BOOL "" FORCE)
    set(ZLIB_BUILD_SHARED OFF CACHE BOOL "" FORCE)
    set(ZLIB_BUILD_STATIC ON CACHE BOOL "" FORCE)
    set(ZLIB_INSTALL OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(nfs_zlib
      URL https://zlib.net/zlib-1.3.2.tar.gz
      URL_HASH SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
      DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(nfs_zlib)
    add_library(ZLIB::ZLIB ALIAS zlibstatic)
  endif()
  # Slideshow decoding lives in the prepared game units and uses the same
  # project-local/SDK compression dependency as the other owned UI resources.
  if(TARGET full_mapped_translation)
    target_link_libraries(full_mapped_translation PRIVATE ZLIB::ZLIB)
  endif()
endif()
if(NFS_CLASSIC_BUNDLE_OWNED_ARTWORK)
  if(NOT NFS_CLASSIC_UI)
    message(FATAL_ERROR "Owned artwork bundle requires opt-in classic UI")
  endif()
  if(NOT NFS_HD_ARTWORK_SHA256 STREQUAL "d9db041426c9c5735a3015e51ce2a37b694a2efd2ff0df204cb43a737e03b372")
    message(FATAL_ERROR "Owned artwork template requires the exact classic artwork release pin")
  endif()
  set(NFS_CLASSIC_OWNER_TEMPLATE "${CMAKE_SOURCE_DIR}/assets/artwork/classic-ui.ownedz" CACHE FILEPATH "Trusted authored owner template")
  if(NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    message(STATUS "Personal artwork omitted from base; authenticated post-build injection required")
  else()
    if(NOT EXISTS "${NFS_CLASSIC_OWNER_TEMPLATE}")
      message(FATAL_ERROR "Classic UI authored owner template missing")
    endif()
    file(SHA256 "${NFS_CLASSIC_OWNER_TEMPLATE}" template_sha)
    if(NOT template_sha STREQUAL "6365180bcab9fbf67d000a77c66e33e162bd338b2557280401b6c046f76e825a")
      message(FATAL_ERROR "Classic UI authored template identity mismatch")
    endif()
  endif()
  set_source_files_properties(src/hd/OwnedArtwork.cpp PROPERTIES COMPILE_OPTIONS "-std=c++17")
  set_property(SOURCE src/hd/ArtworkActivation.cpp app/main.cpp app/desktop_assets.cpp ios/game_assets.mm APPEND PROPERTY COMPILE_DEFINITIONS NFS_CLASSIC_BUNDLED_ART=1)
  get_property(owned_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS owned_targets)
    get_target_property(sources ${target} SOURCES)
    set(has_activation FALSE)
    foreach(source IN LISTS sources)
      if(source MATCHES "(^|/)ArtworkActivation[.]cpp$")
        set(has_activation TRUE)
      endif()
    endforeach()
    if(has_activation)
      target_sources(${target} PRIVATE src/hd/OwnedArtwork.cpp src/hd/ClassicScreens/IntroArtProvider.cpp src/hd/ClassicScreens/IntroArtworkLoader.cpp src/hd/ClassicScreens/TrackInfoArtProvider.cpp src/hd/ClassicScreens/TrackInfoArtworkLoader.cpp src/hd/ClassicScreens/CarInfoArtProvider.cpp src/hd/ClassicScreens/CarInfoArtworkLoader.cpp src/hd/PlayerPhotoArtProvider.cpp src/hd/PlayerPhotoArtworkLoader.cpp src/hd/TrackBadgeArtProvider.cpp src/hd/TrackBadgeArtworkLoader.cpp)
      target_link_libraries(${target} PRIVATE ZLIB::ZLIB)
    endif()
  endforeach()
  foreach(target NFSIISEGame NFSIISEEngineCheck)
    if(TARGET ${target})
      target_link_libraries(${target} PRIVATE ZLIB::ZLIB)
    endif()
  endforeach()
  if(TARGET nfs_game_app AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NFS_CLASSIC_OWNER_TEMPLATE}" "$<TARGET_FILE_DIR:nfs_game_app>/classic-ui.ownedz")
  endif()
  if(TARGET NFSIISEGame AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    set(owned_resource "${CMAKE_CURRENT_BINARY_DIR}/generated/hd/classic-ui.ownedz")
    configure_file("${NFS_CLASSIC_OWNER_TEMPLATE}" "${owned_resource}" COPYONLY)
    set_source_files_properties("${owned_resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    target_sources(NFSIISEGame PRIVATE "${owned_resource}")
  endif()
  set(NFS_CLASSIC_TRACK_INFO_ARTWORK "" CACHE FILEPATH "Optional separately authenticated track-info artwork")
  if(NFS_CLASSIC_TRACK_INFO_ARTWORK AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/hd/ClassicScreens/TrackInfoArtworkPin.h" track_info_pin_line REGEX "^#define NFS_TRACK_INFO_ARTWORK_SHA256 ")
    string(REGEX MATCH "\"([0-9a-f]+)\"" track_info_pin_match "${track_info_pin_line}")
    set(track_info_expected "${CMAKE_MATCH_1}")
    string(LENGTH "${track_info_expected}" track_info_pin_length)
    if(NOT track_info_pin_length EQUAL 64)
      message(FATAL_ERROR "Track-info authored artwork is not finalized or pinned")
    endif()
    file(SHA256 "${NFS_CLASSIC_TRACK_INFO_ARTWORK}" track_info_sha)
    if(NOT track_info_sha STREQUAL track_info_expected)
      message(FATAL_ERROR "Track-info authored resource identity mismatch")
    endif()
    if(TARGET nfs_game_app)
      add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NFS_CLASSIC_TRACK_INFO_ARTWORK}" "$<TARGET_FILE_DIR:nfs_game_app>/track-info-ui.ownedz")
    endif()
    if(TARGET NFSIISEGame)
      set(track_info_resource "${CMAKE_CURRENT_BINARY_DIR}/generated/hd/track-info-ui.ownedz")
      configure_file("${NFS_CLASSIC_TRACK_INFO_ARTWORK}" "${track_info_resource}" COPYONLY)
      set_source_files_properties("${track_info_resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
      target_sources(NFSIISEGame PRIVATE "${track_info_resource}")
    endif()
  endif()
  set(NFS_CLASSIC_CAR_INFO_ARTWORK "" CACHE FILEPATH "Optional separately authenticated car-info artwork")
  if(NFS_CLASSIC_CAR_INFO_ARTWORK AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/hd/ClassicScreens/CarInfoArtworkPin.h" car_info_pin_line REGEX "^#define NFS_CAR_INFO_ARTWORK_SHA256 ")
    string(REGEX MATCH "\"([0-9a-f]+)\"" car_info_pin_match "${car_info_pin_line}")
    set(car_info_expected "${CMAKE_MATCH_1}")
    string(LENGTH "${car_info_expected}" car_info_pin_length)
    if(NOT car_info_pin_length EQUAL 64)
      message(FATAL_ERROR "Car-info authored artwork is not finalized or pinned")
    endif()
    file(SHA256 "${NFS_CLASSIC_CAR_INFO_ARTWORK}" car_info_sha)
    if(NOT car_info_sha STREQUAL car_info_expected)
      message(FATAL_ERROR "Car-info authored resource identity mismatch")
    endif()
    if(TARGET nfs_game_app)
      add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NFS_CLASSIC_CAR_INFO_ARTWORK}" "$<TARGET_FILE_DIR:nfs_game_app>/car-info-ui.ownedz")
    endif()
    if(TARGET NFSIISEGame)
      set(car_info_resource "${CMAKE_CURRENT_BINARY_DIR}/generated/hd/car-info-ui.ownedz")
      configure_file("${NFS_CLASSIC_CAR_INFO_ARTWORK}" "${car_info_resource}" COPYONLY)
      set_source_files_properties("${car_info_resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
      target_sources(NFSIISEGame PRIVATE "${car_info_resource}")
    endif()
  endif()
  set(NFS_CLASSIC_PLAYER_PHOTO_ARTWORK "" CACHE FILEPATH "Optional separately authenticated player-photo artwork")
  if(NFS_CLASSIC_PLAYER_PHOTO_ARTWORK AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/hd/PlayerPhotoArtworkPin.h" player_photo_pin_line REGEX "^#define NFS_PLAYER_PHOTO_ARTWORK_SHA256 ")
    string(REGEX MATCH "\"([0-9a-f]+)\"" player_photo_pin_match "${player_photo_pin_line}")
    set(player_photo_expected "${CMAKE_MATCH_1}")
    string(LENGTH "${player_photo_expected}" player_photo_pin_length)
    if(NOT player_photo_pin_length EQUAL 64)
      message(FATAL_ERROR "Player-photo authored artwork is not finalized or pinned")
    endif()
    file(SHA256 "${NFS_CLASSIC_PLAYER_PHOTO_ARTWORK}" player_photo_sha)
    if(NOT player_photo_sha STREQUAL player_photo_expected)
      message(FATAL_ERROR "Player-photo authored resource identity mismatch")
    endif()
    if(TARGET nfs_game_app)
      add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NFS_CLASSIC_PLAYER_PHOTO_ARTWORK}" "$<TARGET_FILE_DIR:nfs_game_app>/player-photo-ui.ownedz")
    endif()
    if(TARGET NFSIISEGame)
      set(player_photo_resource "${CMAKE_CURRENT_BINARY_DIR}/generated/hd/player-photo-ui.ownedz")
      configure_file("${NFS_CLASSIC_PLAYER_PHOTO_ARTWORK}" "${player_photo_resource}" COPYONLY)
      set_source_files_properties("${player_photo_resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
      target_sources(NFSIISEGame PRIVATE "${player_photo_resource}")
    endif()
  endif()
  set(NFS_CLASSIC_TRACK_BADGE_ARTWORK "" CACHE FILEPATH "Optional separately authenticated track-badge artwork")
  if(NFS_CLASSIC_TRACK_BADGE_ARTWORK AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/hd/TrackBadgeArtworkPin.h" track_badge_pin_line REGEX "^#define NFS_TRACK_BADGE_ARTWORK_SHA256 ")
    string(REGEX MATCH "\"([0-9a-f]+)\"" track_badge_pin_match "${track_badge_pin_line}")
    set(track_badge_expected "${CMAKE_MATCH_1}")
    string(LENGTH "${track_badge_expected}" track_badge_pin_length)
    if(NOT track_badge_pin_length EQUAL 64)
      message(FATAL_ERROR "Track-badge authored artwork is not finalized or pinned")
    endif()
    file(SHA256 "${NFS_CLASSIC_TRACK_BADGE_ARTWORK}" track_badge_sha)
    if(NOT track_badge_sha STREQUAL track_badge_expected)
      message(FATAL_ERROR "Track-badge authored resource identity mismatch")
    endif()
    if(TARGET nfs_game_app)
      add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NFS_CLASSIC_TRACK_BADGE_ARTWORK}" "$<TARGET_FILE_DIR:nfs_game_app>/track-badge-ui.ownedz")
    endif()
    if(TARGET NFSIISEGame)
      set(track_badge_resource "${CMAKE_CURRENT_BINARY_DIR}/generated/hd/track-badge-ui.ownedz")
      configure_file("${NFS_CLASSIC_TRACK_BADGE_ARTWORK}" "${track_badge_resource}" COPYONLY)
      set_source_files_properties("${track_badge_resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
      target_sources(NFSIISEGame PRIVATE "${track_badge_resource}")
    endif()
  endif()
  set(NFS_CLASSIC_INTRO_ARTWORK "" CACHE FILEPATH "Optional separately authenticated intro artwork")
  if(NFS_CLASSIC_INTRO_ARTWORK AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    file(SHA256 "${NFS_CLASSIC_INTRO_ARTWORK}" intro_sha)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/hd/ClassicScreens/IntroArtworkPin.h" intro_pin_line REGEX "^#define NFS_INTRO_ARTWORK_SHA256 ")
    string(REGEX MATCH "\"([0-9a-f]+)\"" intro_pin_match "${intro_pin_line}")
    set(intro_expected "${CMAKE_MATCH_1}")
    if(NOT intro_sha STREQUAL intro_expected)
      message(FATAL_ERROR "Intro authored resource identity mismatch")
    endif()
    if(TARGET nfs_game_app)
      add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NFS_CLASSIC_INTRO_ARTWORK}" "$<TARGET_FILE_DIR:nfs_game_app>/intro-ui.ownedz")
    endif()
    if(TARGET NFSIISEGame)

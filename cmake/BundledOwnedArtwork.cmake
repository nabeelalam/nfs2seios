# Companions share the selected owner-template directory at runtime. Public
# deferred bases omit these bytes; personal injection authenticates the same pins.
set(NFS_CLASSIC_WIDE_MENU_ARTWORK "" CACHE FILEPATH "Optional authenticated responsive menu artwork")
set(NFS_CLASSIC_RESULTS_BACKDROP_ARTWORK "" CACHE FILEPATH "Optional authenticated Results artwork")
set(NFS_CLASSIC_SLIDESHOW_ARTWORK "" CACHE FILEPATH "Optional authenticated slideshow photographs")
set(NFS_CLASSIC_SLIDESHOW_FOOTER_ARTWORK "" CACHE FILEPATH "Optional matching slideshow overlays")
if(NFS_CLASSIC_BUNDLE_OWNED_ARTWORK AND NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
  if((NFS_CLASSIC_SLIDESHOW_ARTWORK AND NOT NFS_CLASSIC_SLIDESHOW_FOOTER_ARTWORK) OR
     (NFS_CLASSIC_SLIDESHOW_FOOTER_ARTWORK AND NOT NFS_CLASSIC_SLIDESHOW_ARTWORK))
    message(FATAL_ERROR "Slideshow photographs and overlays must be supplied together")
  endif()
  function(nfs_classic_companion_resource setting filename expected)
    if(NOT "${${setting}}" STREQUAL "")
      if(NOT EXISTS "${${setting}}" OR IS_DIRECTORY "${${setting}}")
        message(FATAL_ERROR "Missing companion artwork: ${filename}")
      endif()
      file(SHA256 "${${setting}}" actual)
      if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Companion artwork identity mismatch: ${filename}")
      endif()
      if(TARGET nfs_game_app)
        add_custom_command(TARGET nfs_game_app POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${${setting}}" "$<TARGET_FILE_DIR:nfs_game_app>/${filename}")
      endif()
      if(TARGET NFSIISEGame)
        set(resource "${CMAKE_CURRENT_BINARY_DIR}/generated/hd/${filename}")
        configure_file("${${setting}}" "${resource}" COPYONLY)
        set_source_files_properties("${resource}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
        target_sources(NFSIISEGame PRIVATE "${resource}")
      endif()
    endif()
  endfunction()
  nfs_classic_companion_resource(NFS_CLASSIC_WIDE_MENU_ARTWORK "wide-menu-ui.ownedz" "655d43557cec2f013b3d519e5919839ff1a278bde7b3995f17be3830df80d980")
  nfs_classic_companion_resource(NFS_CLASSIC_RESULTS_BACKDROP_ARTWORK "results-backdrop-ui.ownedz" "caf29a73af8966385c1a48d46be59950be6f88b92459566d67bf67146bfa81ae")
  nfs_classic_companion_resource(NFS_CLASSIC_SLIDESHOW_ARTWORK "slideshow-ui.ownedz" "e36dec6e311e55fad6d5824c0b746b3009e5ecf03e021143f03a4e3f1b25a6a4")
  nfs_classic_companion_resource(NFS_CLASSIC_SLIDESHOW_FOOTER_ARTWORK "slideshow-footer.ownedz" "ac3b1083ae688e8ea34862e0e011450167506052d13c3bae747b671588e4452a")
endif()

  endif()
  # Apple executables consume object files through TARGET_OBJECTS, which does
  # not propagate those object targets' private static-library dependencies.
  foreach(target NFSIISEGame NFSIISEEngineCheck)
    if(TARGET ${target})
      target_link_libraries(${target} PRIVATE nfs_slideshow_panorama nfs_victory_art_provider)
    endif()
  endforeach()
  # The authored Knockout provider is installed by ArtworkActivation even
  # when the owner artwork is supplied separately. Carry both headers and
  # linkage to every such target, including standalone activation tests.
  get_property(classic_activation_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS classic_activation_targets)
    get_target_property(activation_sources ${target} SOURCES)
    foreach(source IN LISTS activation_sources)
      if(source MATCHES "(^|/)ArtworkActivation[.]cpp$")
        target_link_libraries(${target} PRIVATE ZLIB::ZLIB nfs_victory_art_provider nfs_slideshow_panorama)
        break()
      endif()
    endforeach()
  endforeach()

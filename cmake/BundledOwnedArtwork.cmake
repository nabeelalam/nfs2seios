if(NFS_CLASSIC_BUNDLE_OWNED_ARTWORK)
  # Fresh builds use the verified release pins. Explicit empty cache pins disable panoramas.
  set(NFS_HISTORY_PANORAMA_ROWS "")
  foreach(archive RANGE 0 6)
    math(EXPR source "${archive} * 7")
    set(setting "NFS_CLASSIC_HISTORY_PANORAMA_${source}")
    set(pin_setting "${setting}_SHA256")
    set(${setting} "" CACHE FILEPATH "Optional History panorama resource")
    string(JSON default_source GET "${nfs_history_release}" panoramas ${archive} sourceIndex)
    string(JSON default_pin GET "${nfs_history_release}" panoramas ${archive} sha256)
    if(NOT default_source EQUAL source)
      message(FATAL_ERROR "History release source order is invalid")
    endif()
    set(${pin_setting} "${default_pin}" CACHE STRING "Trusted whole-file SHA-256 for History panorama")
    if(NOT "${${setting}}" STREQUAL "" AND "${${pin_setting}}" STREQUAL "")
      message(FATAL_ERROR "History panorama requires an explicit trusted SHA-256")
    endif()
    if(NOT "${${pin_setting}}" STREQUAL "")
      string(LENGTH "${${pin_setting}}" pin_length)
      if(NOT pin_length EQUAL 64 OR NOT "${${pin_setting}}" MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "History panorama pin must contain 64 hexadecimal characters")
      endif()
      string(TOLOWER "${${pin_setting}}" panorama_pin)
      if(panorama_pin MATCHES "^0+$")
        message(FATAL_ERROR "History panorama pin must be nonzero")
      endif()
      set(pin_bytes "")
      foreach(index RANGE 0 31)
        math(EXPR offset "${index} * 2")
        string(SUBSTRING "${panorama_pin}" ${offset} 2 byte)
        string(APPEND pin_bytes "0x${byte},")
      endforeach()
      set(filename "history-panorama-${source}.ownedz")
      string(APPEND NFS_HISTORY_PANORAMA_ROWS "  {${source},\"${filename}\",{${pin_bytes}}},\n")
      if(NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
        # Deferred bases compile trust metadata but never copy personal bytes.
        if(NOT "${${setting}}" STREQUAL "")
          if(NOT EXISTS "${${setting}}" OR IS_DIRECTORY "${${setting}}")
            message(FATAL_ERROR "Configured History panorama is missing")
          endif()
          file(SHA256 "${${setting}}" actual_panorama_pin)
          if(NOT actual_panorama_pin STREQUAL panorama_pin)
            message(FATAL_ERROR "Configured History panorama identity mismatch")
          endif()
        endif()
      else()
        nfs_classic_companion_resource(${setting} "${filename}" "${panorama_pin}")
      endif()
    endif()
  endforeach()
  if(NOT NFS_HISTORY_PANORAMA_ROWS STREQUAL "")
    set(panorama_config_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/history-panorama")
    file(MAKE_DIRECTORY "${panorama_config_dir}/hd")
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/src/hd/ClassicScreens/HistoryPanoramaConfiguration.template.h"
      "${panorama_config_dir}/hd/HistoryPanoramaConfiguration.h" @ONLY)
    set_property(SOURCE src/hd/ArtworkActivation.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${panorama_config_dir}")
    set_property(SOURCE src/hd/ArtworkActivation.cpp APPEND PROPERTY COMPILE_DEFINITIONS NFS_HISTORY_PANORAMA_CONFIG=1)
  endif()
endif()

# Optional reviewed slideshow side strips. Empty defaults do not change artwork.
set(NFS_CLASSIC_SLIDESHOW_PANORAMA "" CACHE FILEPATH "Optional reviewed slideshow side-strip resource")
set(NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256 "" CACHE STRING "Trusted whole-file SHA-256 of slideshow side strips")
set(NFS_CLASSIC_SLIDESHOW_PANORAMA_BYTES "0" CACHE STRING "Trusted byte length of slideshow side strips")
if(NFS_CLASSIC_BUNDLE_OWNED_ARTWORK AND NOT NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256 STREQUAL "")
  string(LENGTH "${NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256}" panorama_pin_length)
  if(NOT panorama_pin_length EQUAL 64 OR NOT NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256 MATCHES "^[0-9a-fA-F]+$" OR NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256 MATCHES "^0+$")
    message(FATAL_ERROR "Slideshow panorama requires a nonzero64digit SHA-256")
  endif()
  if(NOT NFS_CLASSIC_SLIDESHOW_PANORAMA_BYTES MATCHES "^[1-9][0-9]*$" OR NFS_CLASSIC_SLIDESHOW_PANORAMA_BYTES GREATER 268456656)
    message(FATAL_ERROR "Slideshow panorama requires a bounded exact byte length")
  endif()
  set(NFS_SLIDESHOW_PANORAMA_PIN_BYTES "")
  string(TOLOWER "${NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256}" NFS_SLIDESHOW_PANORAMA_DELIVERY_SHA)
  foreach(index RANGE 0 31)
    math(EXPR offset "${index} * 2")
    string(SUBSTRING "${NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256}" ${offset} 2 byte)
    string(APPEND NFS_SLIDESHOW_PANORAMA_PIN_BYTES "0x${byte},")
  endforeach()
  if(NOT NFS_CLASSIC_SLIDESHOW_PANORAMA STREQUAL "")
    if(NOT EXISTS "${NFS_CLASSIC_SLIDESHOW_PANORAMA}" OR IS_DIRECTORY "${NFS_CLASSIC_SLIDESHOW_PANORAMA}")
      message(FATAL_ERROR "Configured slideshow panorama is missing")
    endif()
    file(SIZE "${NFS_CLASSIC_SLIDESHOW_PANORAMA}" actual_bytes)
    file(SHA256 "${NFS_CLASSIC_SLIDESHOW_PANORAMA}" actual_pin)
    string(TOLOWER "${NFS_CLASSIC_SLIDESHOW_PANORAMA_SHA256}" expected_pin)
    if(NOT actual_bytes EQUAL NFS_CLASSIC_SLIDESHOW_PANORAMA_BYTES OR NOT actual_pin STREQUAL expected_pin)
      message(FATAL_ERROR "Configured slideshow panorama identity mismatch")
    endif()
  endif()
  set(panorama_config_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/slideshow-panorama")
  file(MAKE_DIRECTORY "${panorama_config_dir}/hd")
  configure_file("${CMAKE_CURRENT_SOURCE_DIR}/src/hd/ClassicScreens/SlideshowPanoramaConfiguration.template.h"
    "${panorama_config_dir}/hd/SlideshowPanoramaConfiguration.h" @ONLY)
  set_property(SOURCE src/hd/ArtworkActivation.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${panorama_config_dir}")
  set_property(SOURCE src/hd/ArtworkActivation.cpp APPEND PROPERTY COMPILE_DEFINITIONS NFS_SLIDESHOW_PANORAMA_CONFIG=1)
  if(NOT NFS_CLASSIC_DEFER_OWNER_TEMPLATE)
    nfs_classic_companion_resource(NFS_CLASSIC_SLIDESHOW_PANORAMA "slideshow-panorama.ownedz" "${expected_pin}")
  endif()
elseif(NOT NFS_CLASSIC_SLIDESHOW_PANORAMA STREQUAL "")
  message(FATAL_ERROR "Slideshow panorama artwork requires explicit release identity")
endif()
